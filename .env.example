# Copy this file to .env for local Docker Compose, or paste these values into
# Portainer stack environment variables. Run ./scripts/bootstrap-env.sh to create
# a local .env with generated secrets and detected Intel GPU group IDs.

COMPOSE_PROJECT_NAME=ollama-server

# Images are configurable so upgrades can be tested by changing environment only.
OLLAMA_IMAGE=ollama/ollama:latest
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# Bind all host interfaces for LAN access. Change BIND_ADDRESS to a specific LAN
# IP if this host ever has an internet-routed interface. OLLAMA_HOST is not a
# stack variable; Compose pins the in-container listener to 0.0.0.0:11434 and
# these values control host-side publishing.
BIND_ADDRESS=0.0.0.0
OLLAMA_PORT=11434
OPEN_WEBUI_PORT=3000

# Host persistence paths. These are bind mounts, not Docker named volumes.
# Put OLLAMA_MODELS_DIR on the Docker host drive where large LLM files should
# live.
OLLAMA_DATA_DIR=/opt/ollama-server/ollama
OLLAMA_MODELS_DIR=/srv/ollama-server/models
OPEN_WEBUI_DATA_DIR=/opt/ollama-server/open-webui

# Intel Arc / Vulkan GPU access. The defaults below match this Ubuntu host at
# scaffold time. Re-run ./scripts/bootstrap-env.sh or `ls -lnd /dev/dri/*` after
# driver or host changes and update the group IDs if needed.
OLLAMA_GPU_DEVICE=/dev/dri
OLLAMA_GPU_RENDER_GROUP_ID=989
OLLAMA_GPU_CARD_GROUP_ID=985
OLLAMA_VULKAN=1
GGML_VK_VISIBLE_DEVICES=
OLLAMA_SHM_SIZE=2g

# Ollama server behavior.
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_ORIGINS=

# Open WebUI connection to the internal Ollama service.
OPEN_WEBUI_OLLAMA_BASE_URL=http://ollama:11434
OPEN_WEBUI_RAG_OLLAMA_BASE_URL=http://ollama:11434
OPEN_WEBUI_ENABLE_OLLAMA_API=True
OPEN_WEBUI_ENABLE_OPENAI_API=False
OPEN_WEBUI_NAME=Local Ollama

# Authentication stays enabled. The admin account is created only on fresh
# Open WebUI data when both email and password are set.
OPEN_WEBUI_AUTH=True
OPEN_WEBUI_ENABLE_SIGNUP=False
OPEN_WEBUI_ADMIN_NAME=Admin
OPEN_WEBUI_ADMIN_EMAIL=admin@ollama.local
OPEN_WEBUI_ADMIN_PASSWORD=replace-with-strong-generated-password
OPEN_WEBUI_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
